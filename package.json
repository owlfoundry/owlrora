{
  "name": "owlrora",
  "version": "0.0.0-dev",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm --filter @owlrora/web build",
    "check": "pnpm --filter @owlrora/web check",
    "dev": "pnpm --filter @owlrora/web dev",
    "docs:build": "pnpm --filter @owlrora/docs build",
    "docs:deploy": "pnpm --filter @owlrora/docs deploy",
    "docs:dev": "pnpm --filter @owlrora/docs dev",
    "format": "pnpm --filter @owlrora/web format",
    "test": "pnpm --filter @owlrora/web test"
  }
}
