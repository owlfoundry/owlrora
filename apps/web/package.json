{
  "name": "@owlrora/web",
  "version": "0.0.0-dev",
  "private": true,
  "description": "OwlRora web application",
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build && vite build",
    "check": "eslint . --max-warnings 0 && prettier --check . && tsc --build --pretty false",
    "dev": "vite",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.3.0",
    "prettier": "3.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.0"
  }
}
