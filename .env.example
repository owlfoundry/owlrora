# OwlRora local application environment used by `make dev`.
# Copy this file to `.env`. Every credential below is public and disposable;
# generate independent random values before using OwlRora outside local development.
# `make dev` starts the PostgreSQL and Redis services in dev/compose.yml.
# Keep the same secret root for the lifetime of an installation and its backups.

OWLRORA_PROFILE=full
OWLRORA_ADDR=127.0.0.1:8080
OWLRORA_PUBLIC_ORIGIN=http://127.0.0.1:8080

OWLRORA_DATABASE_URL=postgresql://owlrora:owlrora_dev@127.0.0.1:55432/owlrora
OWLRORA_DATABASE_MAX_CONNECTIONS=16

OWLRORA_REDIS_URL=redis://127.0.0.1:56379/
OWLRORA_REDIS_POOL_SIZE=8

OWLRORA_SEED_ADMIN_API_KEY=owlrora_mgmt_v1.CQkJCQkJCQkJCQkJCQkJCQ.CgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgo
OWLRORA_SECRET_ROOT=CwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCws

OWLRORA_OPERATOR_NETWORKS=127.0.0.0/8,::1/128
OWLRORA_SESSION_LIFETIME_SECONDS=28800
OWLRORA_MAX_SECURITY_SNAPSHOT_AGE_SECONDS=30

# Optional readiness policy: stable route UUIDs, not model names.
# OWLRORA_REQUIRED_ROUTE_IDS=019b25d7-ef79-7000-8000-000000000003
# Drain deadlines begin at SIGTERM/Ctrl+C; orchestration grace must be longer.
# OWLRORA_SHUTDOWN_REQUEST_TIMEOUT_SECONDS=15
# OWLRORA_SHUTDOWN_STREAM_TIMEOUT_SECONDS=30
# OWLRORA_SHUTDOWN_WORKER_TIMEOUT_SECONDS=10

# Optional OTLP/HTTP protobuf collector; absent means no telemetry exporter.
# OWLRORA_OTLP_ENDPOINT=http://127.0.0.1:4318
# OWLRORA_TRACE_SAMPLE_RATIO=0.1
